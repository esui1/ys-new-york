{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ]},
    { "source": "/og.png", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ]},
    { "source": "/favicon.svg", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ]},
    { "source": "/atelier.webp", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ]}
  ]
}
